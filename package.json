{
  "name": "specstride",
  "version": "0.0.0",
  "private": true,
  "description": "Carries a Spec Kit feature to done, phase by phase, behind an independent critic.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "node scripts/ci-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:imports": "node tools/import-boundary/src/index.ts",
    "build:plugin": "node scripts/build-plugin.ts dist",
    "e2e": "node scripts/plugin-e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
