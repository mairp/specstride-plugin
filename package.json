{
  "name": "specstride",
  "version": "0.0.0",
  "private": true,
  "description": "Carries a Spec Kit feature to done, phase by phase, behind an independent critic.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "test": "node scripts/ci-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:imports": "node tools/import-boundary/src/index.ts",
    "build:plugin": "node scripts/build-plugin.ts dist",
    "e2e": "node scripts/plugin-e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  }
}
