  "structured": "none until capture 1: no entry may carry the confidence 'structured' while the capture has not recorded a structured quota record, or shown that none exists (F131-FR-034)",
  "entries": [
    {
      "id": "login-limit-text",
      "tier": 1,
      "source": ["stream-error-record", "stderr", "reply"],
      "match": { "textAny": ["usage limit", "usage limit has been reached", "try again in"] },
      "class": "quota_window",
      "confidence": "text",
      "retryable": true,
      "resetsAt": "parse",
      "status": "unverified (capture 1: the record and the exit code at a login limit)"
    },
    {
      "id": "quota-credit",
      "tier": 2,
      "source": ["http-reply", "stream-error-record"],
      "match": { "bodyCode": "insufficient_quota" },
      "class": "quota_credit",
      "confidence": "status",
      "retryable": false,
      "state": "blocked-on-human",
      "status": "unverified (documentation only)"
    },
    {
      "id": "rate-limit-429",
      "tier": 2,
      "source": ["http-reply", "stream-error-record"],
      "match": { "status": 429, "bodyCodeNot": "insufficient_quota" },
      "class": "rate_limit_transient",
      "confidence": "status",
      "retryable": true,
      "status": "unverified (documentation only)"
    },
    {
      "id": "auth-401",
      "tier": 2,
      "source": ["http-reply", "stream-error-record"],
      "match": { "status": 401 },
      "class": "auth",
      "confidence": "status",
      "retryable": false,
      "remedy": "the OPENAI_API_KEY credential",
      "status": "unverified (documentation only)"
    },
    {
      "id": "no-match",
      "tier": null,
      "source": ["any"],
      "match": { "otherwise": true },
      "class": "provider_other",
      "confidence": "text",
      "retryable": true
    }
  ],
  "retryableByClass": {
