          "endpoint": "openai-chat",
          "address": "https://api.openai.com/v1",
          "addressAlias": "OPENAI_BASE_URL",
          "chatPath": "/chat/completions",
          "keyReference": "OPENAI_API_KEY",
          "modelDefault": "gpt-5",
          "modelAlias": "SPECSTRIDE_CODEX_CRITIC_MODEL",
          "outputLimitUnderParity": false,
          "toolless": "by construction (F131-FR-025)",
