{
  "schema": "specstride.adapter-argument-table/1",
  "harness": "dsh",
  "pin": "0.1.0-rc.8",
  "verifiedOn": "2026-09-29",
  "note": "Entries marked unverified wait for the captures of F130-FR-042.",
  "version": { "argv": ["{bin}", "--version"], "status": "verified-on 2026-09-29" },
  "roles": {
    "proposer": {
      "argv": ["{bin}", "--profile", "{profile}", "{prompt}"],
      "promptLimitBytes": 122880,
      "overLimit": {
        "outsideParity": "chunks split at ASCII spaces, none starting with a dash",
        "underParity": "one argument, as the baseline",
        "status": "unverified (capture 4)"
      },
      "stdin": "closed",
      "cwd": "{workdir}",
      "env": {
        "DSH_HOME": "{home or overlay}",
        "DSH_PERMISSION_MODE": "{permissionMode}",
        "DSH_TELEMETRY_MODE": "{off value, unverified (capture 5)}",
        "TRACEPARENT": "{trace parent, when traces are on}"
      },
      "permissionMode": {
        "parity": "workspace-write",
        "default": "workspace-write",
        "optIn": "danger-full-access only with sandbox.level C0"
      },
      "notFound": { "status": 127, "message": "DeepSeek Harness not found: {bin}" }
    },
    "critic": {
      "argv": [
        "{bin}",
        "--profile",
        "{profile}",
        "--patch",
        "{file:criticPatch}",
        "--",
        "{promptChunks...}"
      ],
      "chunkLimitBytes": 122880,
      "cwd": { "parity": "{workdir}", "default": "{emptyTmp}" },
      "env": {
        "DSH_HOME": "{home or overlay}",
        "DSH_PERMISSION_MODE": "read-only",
        "DSH_TELEMETRY_MODE": "{off value}"
      },
      "reply": "stdout",
      "failure": {
        "nonZeroExit": "first 300 characters of stderr, else of stdout",
        "emptyStdout": "error",
        "timeout": "error",
        "launch": "error"
      }
    }
  },
  "pluginInstall": {
    "argv": ["{bin}", "plugin", "--profile", "{profile}", "add", "--save-exact", "{plugins...}"],
    "shell": false,
    "timeoutSec": 600
  },
  "toolIntrospection": { "argv": "to be named after capture 3", "status": "unverified" },
  "overlay": {
    "prefix": "specstride-dsh-home.",
    "settingsFile": "settings.yaml",
    "block": "agent-default-model"
  }
}
