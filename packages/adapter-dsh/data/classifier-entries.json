{
  "schema": "specstride.adapter-classifier-entries/1",
  "harness": "dsh",
  "pin": "0.1.0-rc.8",
  "verifiedOn": "2026-09-29 for the codes; the message forms are unverified (capture 5)",
  "form": "dsh: <CODE>: <message>",
  "streams": ["stderr", "stdout"],
  "entries": [
    {
      "code": "QUOTA",
      "class": "quota_window",
      "confidence": "status",
      "orWhen": { "messageSaysCredit": "quota_credit" },
      "resetsAt": "parsed from the message, else null"
    },
    { "code": "RATE_LIMIT", "class": "rate_limit_transient", "confidence": "status" },
    {
      "code": "CONTEXT_WINDOW_EXCEEDED",
      "class": "context_window",
      "confidence": "status",
      "neverScoredAs": "MALFORMED"
    },
    { "code": "INVALID_CREDENTIAL", "class": "auth", "confidence": "status" }
  ],
  "noMatch": { "class": "provider_other", "confidence": "text" }
}
