{
  "schema": "specstride.layout/1",
  "note": "Generated from the annexes of specs/100-specstride by contracts/tools/generate.py. The annex stands where the two differ.",
  "annex": "annex B, §B.1, §B.5",
  "layoutVersion": "1.2",
  "roots": {
    "<user-config>": "$XDG_CONFIG_HOME/specstride, default ~/.config/specstride",
    "<user-state>": "$XDG_STATE_HOME/specstride/user, default ~/.local/state/specstride/user",
    "<user-cache>": "$XDG_CACHE_HOME/specstride, default ~/.cache/specstride",
    "<control>": "$XDG_STATE_HOME/specstride/workspaces/<workspaceId>, or the control root the consumer set. Directories 0700, files 0600",
    "<workspace>": "The root of the working tree",
    "<workspace-part>": "<workspace>/.specstride",
    "<worker-root>": "$XDG_CACHE_HOME/specstride/workers. Directories 0700",
    "<attempt-dir>": "<control>/features/<slug>/runs/<runId>/phases/<N>/attempts/e<k>-a<n>; found through the record of the pass, the unit or the job",
    "<temp>": "The temporary directory of the system",
    "<package>": "The installed package, read only. The build of the published package copies each workspace package's data/ tree into it, so that packages/harness/data/descriptors/<id>.yaml feeds package:harness:<id> and packages/harness/data/catalogue/ feeds package:catalogue, and code reads these files only through their logical names",
    "<harness-home>": "The configuration home of the harness, from its descriptor",
    "liveness endpoint": "A short path in the per-user runtime directory; the lock directory holds a reference to it (socket paths are limited to about 104 bytes on macOS, unverified)"
  },
  "locations": [
    {
      "Location": "User-level state",
      "Logical root": "`user`",
      "What it is": "The consumer's configuration, consumer-declared harness descriptors and toolchain profiles, newer terms-gate data, results of harness verification, the tripwire",
      "Who writes": "The consumer; the CLI on the consumer's request; the runtime for the tripwire only",
      "Who reads": "CLI, runtime, doctor"
    },
    {
      "Location": "Control plane, one per workspace",
      "Logical root": "`control`",
      "What it is": "Everything the runtime decides on. It lies outside the working tree, in the user's state directory, keyed by the workspace id",
      "Who writes": "The runtime tree. The CLI writes only what the table of §B.5 gives it as writer: inbox requests, launch records with the comment beside them, the supervision record, the run snapshot and the resolved registry at launch, the launch contract with its bundle and retrospective, and the inventory and the verification commands of a reverse run (F100-FR-003, F100-FR-217)",
      "Who reads": "CLI, doctor, renderers, the builder of the fact block"
    },
    {
      "Location": "Workspace part",
      "Logical root": "`workspace`",
      "What it is": "What the proposer produces for the runtime, and the handoff the runtime writes for the proposer. It lies inside the working tree",
      "Who writes": "The proposer; the runtime for the handoff and the advisory marker",
      "Who reads": "The proposer, the runtime, grounding (phase evidence only)"
    },
    {
      "Location": "Worker root",
      "Logical root": "`worker-root`",
      "What it is": "The trees of the workers of parallel units. It lies outside the workspace and outside the control plane, in the user's cache directory",
      "Who writes": "The engine creates and removes trees; a worker's harness writes inside its own tree",
      "Who reads": "The engine"
    }
  ],
