{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:specstride:schema:specstride.integrity-rules-116/1",
 "title": "Feature 116 integrity rules table",
 "type": "object",
 "properties": {
  "schema": {
   "const": "specstride.integrity-rules-116/1"
  },
  "note": {
   "type": "string"
  },
  "rules": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "rule": {
      "type": "string",
      "pattern": "^IR-[0-9]+$"
     },
     "subject": {
      "type": "string",
      "minLength": 1
     },
     "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "pattern": "^F116-FR-[0-9]+$"
      }
     },
     "test": {
      "type": "string",
      "pattern": "^CT-116-[0-9]+$"
     }
    },
    "required": [
     "rule",
     "subject",
     "requirements",
     "test"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "rules"
 ],
 "additionalProperties": false
}
