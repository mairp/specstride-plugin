{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specstride:schema:internal:103:pass-loop-result/1",
  "title": "Result of the pass loop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exit_code"
  ],
  "properties": {
    "exit_code": {
      "enum": [
        0,
        1,
        3,
        4,
        6,
        7,
        8,
        9,
        10,
        130,
        143
      ],
      "description": "The table 'Pass loop' of annex E section E.4. 124 and 127 are statuses of a pass, kept in the pass record, and are not results of the loop"
    },
    "passReached": {
      "type": "integer"
    },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "declared-block",
            "source-changed"
          ],
          "description": "The two reasons that the pass loop can report; the others of annex E section E.2 are reported by the engine"
        },
        "file": {
          "enum": [
            "spec",
            "plan",
            "tasks"
          ],
          "description": "Present for source-changed (F103-FR-021)"
        },
        "needs": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "string",
      "description": "First line of the as-is message, for a usage failure (F103-FR-002)"
    },
    "usage": {
      "type": "string",
      "description": "The usage text, for `help` and for a usage failure"
    }
  }
}
