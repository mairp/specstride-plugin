{
  "schema": "specstride.learning.mode-phrases/1",
  "feature": "106-learning",
  "comment": [
    "The phrase table of the mode selector (T065, contracts/mode-selector.md,",
    "F106-FR-032). Every member is one pattern copied verbatim from the baseline's",
    "selector (supervisor_lib.py:214-233 at 9c88f86, `_LEARNING_OFF`,",
    "`_LEARNING_APPLY`, `_LEARNING_SUGGEST` and `LEARNING_TOKENS`), one entry per",
    "pattern, in the baseline's order. The patterns are regular expressions",
    "matched against the lower-cased request with a plain search; the first",
    "pattern in the first group that matches wins, in the selector's order:",
    "tokens, refusal, apply, suggest. `tokens` maps the explicit invocation token",
    "to the mode it selects; the tokens given by option are tried first, then the",
    "flag-shaped words of the request."
  ],
  "tokens": {
    "--learning-off": "off",
    "--learning-suggest": "suggest",
    "--learning-apply": "apply"
  },
  "refusal": [
    "\\b(?:no|without|disable|turn\\s+off|skip)\\s+(?:the\\s+)?(?:learning|self[- ]improv\\w*|self[- ]tun\\w*)",
    "\\blearning\\s*(?:=|:|mode\\s+)?\\s*off\\b"
  ],
  "apply": [
    "\\blearning\\s*(?:=|:|mode\\s+)?\\s*apply\\b",
    "\\bapply\\s+(?:the\\s+)?(?:learned|learnt)\\b",
    "\\buse\\s+(?:the\\s+)?(?:learned|learnt|applied)\\s+(?:values?|settings?|decisions?|timeouts?|knobs?)\\b",
    "\\bwith\\s+(?:the\\s+)?(?:applied|learned)\\s+(?:decisions?|values?|settings?)\\b"
  ],
  "suggest": [
    "\\blearning\\s*(?:=|:|mode\\s+)?\\s*suggest\\b",
    "\\b(?:enable|turn\\s+on|with)\\s+(?:the\\s+)?learning\\b",
    "\\bself[- ]improv\\w*",
    "\\bself[- ]tun\\w*",
    "\\blearn\\s+from\\s+(?:the\\s+|this\\s+|its\\s+|previous\\s+|past\\s+)?runs?\\b",
    "\\brecord\\s+(?:the\\s+)?observations?\\b"
  ]
}
