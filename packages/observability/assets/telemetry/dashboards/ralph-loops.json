  "templating": {
    "list": [
      {
        "name": "task",
        "label": "task",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "task",
          "stream": "",
          "refId": "task"
        },
        "definition": "task"
      },
      {
        "name": "backend",
        "label": "backend",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "backend",
          "stream": "",
          "refId": "backend"
        },
        "definition": "backend"
      },
      {
        "name": "role",
        "label": "role",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "role",
          "stream": "",
          "refId": "role"
        },
        "definition": "role"
      },
      {
        "name": "run",
        "label": "run",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "invocation",
        "label": "invocation",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Ralph Loops",
  "uid": "ralph-loops",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Runs",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"ralph\", event=~\"run_start\", task=~\"$task\", backend=~\"$backend\", role=~\"$role\"} | logfmt | run_id =~ \"$run\" | invocation_id =~ \"$invocation\" [$__interval]))",
          "refId": "A",
          "legendFormat": "runs"
        }
      ]
    },
    {
      "id": 2,
      "title": "Iterations",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"ralph\", event=~\"iter_start\", task=~\"$task\", backend=~\"$backend\", role=~\"$role\"} | logfmt | run_id =~ \"$run\" | invocation_id =~ \"$invocation\" [$__interval]))",
          "refId": "A",
