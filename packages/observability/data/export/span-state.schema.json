{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specstride:schema:specstride.span-state/1",
  "title": "Open spans of one logical run (logical name run:<runId>:span-state; schema id of annex B §B.20 of feature 100, owner 128). Written only by the exporter. The field schema holds the schema id with its major (F100-FR-048); there is no field v.",
  "type": "object",
  "required": ["schema", "runId", "traceId", "stack"],
  "properties": {
    "schema": { "const": "specstride.span-state/1" },
    "runId": { "type": "string" },
    "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scope", "spanId", "startTimeUnixNano", "attributes"],
        "properties": {
          "scope": { "type": "string" },
          "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "parentSpanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
          "startTimeUnixNano": { "type": "string" },
          "attributes": { "type": "object" },
          "openedBySeq": { "type": "integer" }
        }
      }
    }
  },
  "additionalProperties": true
}
