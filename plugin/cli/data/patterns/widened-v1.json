{
  "schema": "specstride.redaction/1",
  "version": "specstride-redaction/widened-1+57db06d30c8b607f",
  "keyNames": [
    {
      "name": "api_key",
      "pattern": "^api_key$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "apikey",
      "pattern": "^apikey$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "authorization",
      "pattern": "^authorization$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "cookie",
      "pattern": "^cookie$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "credential",
      "pattern": "^credential$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "password",
      "pattern": "^password$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "secret",
      "pattern": "^secret$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "token",
      "pattern": "^token$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "access_token",
      "pattern": "^access_token$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "refresh_token",
      "pattern": "^refresh_token$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "client_secret",
      "pattern": "^client_secret$",
      "flags": "i",
      "match": "exact"
    },
    {
      "name": "suffix-token",
      "pattern": "_token$",
      "flags": "i",
      "match": "suffix"
    },
    {
      "name": "suffix-key",
      "pattern": "_key$",
      "flags": "i",
      "match": "suffix"
    },
    {
      "name": "suffix-secret",
      "pattern": "_secret$",
      "flags": "i",
      "match": "suffix"
    },
    {
      "name": "substring-password",
      "pattern": "password",
      "flags": "i",
      "match": "substring"
    }
  ],
  "values": [
    {
      "name": "bearer",
      "pattern": "\\bbearer\\s+[A-Za-z0-9._~+/=-]{8,}",
      "flags": "i",
      "covers": "signed tokens"
    },
    {
      "name": "sk-prefix",
      "pattern": "\\bsk-[A-Za-z0-9_-]{8,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "github-prefix",
      "pattern": "\\bgh[pousr]_[A-Za-z0-9]{8,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "key-name-then-value",
      "pattern": "\\b(?:api[_-]?key|token|secret|password)\\s*[=:]\\s*[^\\s,;]+",
      "flags": "i",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "private-key-block",
      "pattern": "-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----",
      "flags": "",
      "covers": "private-key blocks"
    },
    {
      "name": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "flags": "",
      "covers": "signed tokens"
    },
    {
      "name": "aws-access-key-id",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": "",
      "covers": "access key ids of clouds"
    },
    {
      "name": "google-access-key-id",
      "pattern": "\\bGOOG[0-9A-Z]{16,}\\b",
      "flags": "",
      "covers": "access key ids of clouds"
    },
    {
      "name": "url-embedded-credentials",
      "pattern": "\\b[a-z][a-z0-9+.-]*://[^\\s/:@<>\"'`]+:[^\\s/@<>\"'`]+@",
      "flags": "i",
      "covers": "addresses with embedded credentials"
    },
    {
      "name": "slack-prefix",
      "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "google-api-key-prefix",
      "pattern": "\\bAIza[0-9A-Za-z_-]{30,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "gitlab-prefix",
      "pattern": "\\bglpat-[A-Za-z0-9_-]{16,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "npm-prefix",
      "pattern": "\\bnpm_[A-Za-z0-9]{32,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "huggingface-prefix",
      "pattern": "\\bhf_[A-Za-z0-9]{16,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    },
    {
      "name": "digitalocean-prefix",
      "pattern": "\\bdop_v1_[a-f0-9]{32,}",
      "flags": "",
      "covers": "prefixes of provider keys"
    }
  ]
}
