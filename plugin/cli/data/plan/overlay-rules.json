{
  "schema": "specstride.plan-data/1",
  "note": "Data of the plan of feature 109. spec.md stands where the two differ.",
  "requirement": "F109-FR-030; F109-FR-031; F109-FR-032",
  "keyPattern": "^[a-z][a-z0-9]*$",
  "fields": ["vars", "seeds"],
  "varPattern": "^[A-Z_][A-Z0-9_]*$",
  "reserved": {
    "names": ["PATH", "PWD", "SHELL"],
    "prefixes": ["GIT_AUTHOR_", "GIT_COMMITTER_", "SPECSTRIDE_"]
  },
  "seedFields": ["var", "path", "content"],
  "credentialWords": ["api key", "secret", "token", "password", "bearer", "authorization"],
  "scopeValues": ["", "pass", "attempt"],
  "defaultScopeWhenDeclared": "pass",
  "scopeWithoutDeclaration": "none",
  "baseDirectoryVariables": [
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_CACHE_HOME",
    "XDG_STATE_HOME"
  ],
  "alwaysSet": ["GIT_CONFIG_GLOBAL"],
  "identityVariables": [
    "GIT_AUTHOR_NAME",
    "GIT_AUTHOR_EMAIL",
    "GIT_COMMITTER_NAME",
    "GIT_COMMITTER_EMAIL"
  ],
  "modes": {
    "variableDirectory": "0700",
    "seedFile": "0600",
    "seedParent": "0700"
  },
  "recordOrder": ["unset", "set:declared", "set:GIT_CONFIG_GLOBAL", "set:identity"],
  "messages": {
    "invalidScope": "<VAR>='<v>' is invalid; accepted values: pass, attempt",
    "noOverlay": "specstride: warning: <VAR> is set but backend '<id>' has no overlay; ignoring it",
    "stale": "specstride: removed stale overlay <root> (owner <pid> gone)",
    "removal": "specstride: warning: could not remove overlay <root>: <cause>",
    "creation": "<component>: could not create overlay for backend '<id>' in <dir>: <cause>",
    "notFound": "<component>: <executable> not found"
  },
  "resultCodes": {
    "scope": [0, 3],
    "startup": [0, 1, 3],
    "populate": [0, 1],
    "remove": [0],
    "reap": [0],
    "sweep": [0],
    "executableNotFound": 127,
    "interruptWithAttemptScope": 130,
    "terminateWithAttemptScope": 143
  }
}
