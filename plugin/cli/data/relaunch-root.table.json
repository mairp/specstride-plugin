{
  "schema": "specstride.table/1",
  "id": "relaunch-root",
  "version": "1.0.0",
  "points": {
    "relaunch": {
      "signals": {
        "stopRequested": "boolean",
        "interrupted": "boolean",
        "blocked": "boolean",
        "cause": "text",
        "exitCode": "whole number",
        "retryable": "boolean",
        "stageReasonClass": "text",
        "childExitListed": "boolean",
        "reasonAllowed": "boolean",
        "contractChanged": "boolean",
        "learningChanged": "boolean",
        "launcherEdited": "boolean",
        "budgetRemaining": "whole number",
        "deadlinePassed": "boolean",
        "held": "boolean"
      },
      "choices": [
        "blocked-on-human",
        "budget-deadline-exceeded",
        "budget-exhausted",
        "child-exit-not-retryable",
        "classified-crash",
        "classified-transient",
        "contract-digest-changed",
        "deliberate-stop",
        "exec-error",
        "interrupted",
        "launcher-edited",
        "learning-decisions-changed",
        "lease-lost",
        "operator-stop",
        "postcondition-failure",
        "relaunch-held",
        "setup-required",
        "signal-stop",
        "stage-did-not-fail",
        "stage-did-not-run",
        "stage-precondition",
        "stage-reason-not-transient",
        "stop-not-retryable",
        "stop-reason-not-allowed"
      ]
    }
  },
  "rows": {
    "relaunch": [
      {
        "ruleId": "R-01",
        "choice": "operator-stop",
        "decision": "refuse",
        "when": {
          "equal": ["stopRequested", true]
        }
      },
      {
        "ruleId": "R-02",
        "choice": "signal-stop",
        "decision": "refuse",
        "when": {
          "equal": ["interrupted", true]
        }
      },
      {
        "ruleId": "R-03",
        "choice": "blocked-on-human",
        "decision": "refuse",
        "when": {
          "equal": ["blocked", true]
        }
      },
      {
        "ruleId": "R-04",
        "choice": "lease-lost",
        "decision": "refuse",
        "when": {
          "equal": ["cause", "owner-lost"]
        }
      },
      {
        "ruleId": "R-05",
        "choice": "deliberate-stop",
        "decision": "refuse",
        "when": {
          "and": [
            {
              "equal": ["exitCode", 6]
            },
            {
              "equal": ["cause", "normal"]
            }
          ]
        }
      },
      {
        "ruleId": "R-06",
        "choice": "postcondition-failure",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "postcondition"]
        }
      },
      {
        "ruleId": "R-07",
        "choice": "stage-precondition",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "stage-precondition"]
        }
      },
      {
        "ruleId": "R-08",
        "choice": "setup-required",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "setup-required"]
        }
      },
      {
        "ruleId": "R-09",
        "choice": "interrupted",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "interrupted"]
        }
      },
      {
        "ruleId": "R-10",
        "choice": "stage-did-not-run",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "existing-prerequisite"]
        }
      },
      {
        "ruleId": "R-11",
        "choice": "stage-did-not-fail",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "completed"]
        }
      },
      {
        "ruleId": "R-12",
        "choice": "exec-error",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "exec-error"]
        }
      },
      {
        "ruleId": "R-13",
        "choice": "stage-reason-not-transient",
        "decision": "refuse",
        "when": {
          "equal": ["stageReasonClass", "other"]
        }
      },
      {
        "ruleId": "R-14",
        "choice": "stop-not-retryable",
        "decision": "refuse",
        "when": {
          "and": [
            {
              "notEqual": ["cause", "crash"]
            },
            {
              "not": {
                "equal": ["retryable", true]
              }
            }
          ]
        }
      },
      {
        "ruleId": "R-15",
        "choice": "child-exit-not-retryable",
        "decision": "refuse",
        "when": {
          "and": [
            {
              "notEqual": ["cause", "crash"]
            },
            {
              "not": {
                "equal": ["childExitListed", true]
              }
            }
          ]
        }
      },
      {
        "ruleId": "R-16",
        "choice": "stop-reason-not-allowed",
        "decision": "refuse",
        "when": {
          "and": [
            {
              "notEqual": ["cause", "crash"]
            },
            {
              "not": {
                "equal": ["reasonAllowed", true]
              }
            }
          ]
        }
      },
      {
        "ruleId": "R-17",
        "choice": "contract-digest-changed",
        "decision": "refuse",
        "when": {
          "equal": ["contractChanged", true]
        }
      },
      {
        "ruleId": "R-18",
        "choice": "learning-decisions-changed",
        "decision": "refuse",
        "when": {
          "equal": ["learningChanged", true]
        }
      },
      {
        "ruleId": "R-19",
        "choice": "launcher-edited",
        "decision": "refuse",
        "when": {
          "equal": ["launcherEdited", true]
        }
      },
      {
        "ruleId": "R-20",
        "choice": "budget-exhausted",
        "decision": "refuse",
        "when": {
          "not": {
            "greater": ["budgetRemaining", 0]
          }
        }
      },
      {
        "ruleId": "R-21",
        "choice": "budget-deadline-exceeded",
        "decision": "refuse",
        "when": {
          "equal": ["deadlinePassed", true]
        }
      },
      {
        "ruleId": "R-22",
        "choice": "relaunch-held",
        "decision": "hold",
        "when": {
          "equal": ["held", true]
        }
      },
      {
        "ruleId": "R-23",
        "choice": "classified-crash",
        "decision": "relaunch",
        "when": {
          "equal": ["cause", "crash"]
        }
      },
      {
        "ruleId": "R-24",
        "choice": "classified-transient",
        "decision": "relaunch"
      }
    ]
  }
}
