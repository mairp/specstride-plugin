{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specstride:schema:internal:123:lines/1",
  "title": "The line table of the pipeline entry and of the supervise verbs (feature 123, §R.2, §R.7, §R.8)",
  "type": "object",
  "required": ["schema", "mode", "pipelineLines", "superviseVerbs"],
  "properties": {
    "schema": { "const": "specstride.pipeline-lines-123/1" },
    "mode": { "type": "string", "enum": ["compatibility", "default"] },
    "pipelineLines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "when", "stream", "hue"],
        "properties": {
          "line": { "type": "string", "minLength": 1 },
          "when": { "type": "string" },
          "stream": { "type": "string" },
          "hue": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "superviseLabels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line"],
        "properties": { "line": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    },
    "superviseVerbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verb", "does", "exit"],
        "properties": {
          "verb": { "type": "string", "minLength": 1 },
          "does": { "type": "string" },
          "exit": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
